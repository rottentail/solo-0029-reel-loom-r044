    },
    {
      "workflow_id": "signal",
      "description": "可复用分析结果与参数语义隔离",
      "observable_failure": "不同静音门限错误复用同一分析"
    },
    {
      "workflow_id": "waveform",
      "description": "有限桶数与完整采样覆盖之间的约束",
      "observable_failure": "尾部样本丢失或重复纳入"
    },
    {
      "workflow_id": "loudness",
      "description": "解码测量值与可序列化分析事实之间的约束",
      "observable_failure": "静音导致非标准 JSON 或假零响度"
    },
    {
      "workflow_id": "sheet",
      "description": "固定容量版面与全时长画面覆盖",
      "observable_failure": "画面时间与标称抽样索引不相符"
    },
    {
      "workflow_id": "captions",
      "description": "同一源多次出现与字幕映射重复之间的约束",
      "observable_failure": "源时间被误认为成片时间"
    },
    {
      "workflow_id": "imprint",
      "description": "交付事实不可变与继续剪辑之间的约束",
      "observable_failure": "后来修订改变历史交付包"
    },
    {
      "workflow_id": "cancel-retry",
      "description": "取消请求与产物提交事务的竞争",
      "observable_failure": "已经确认取消的作业留下成功产物"
    },
    {
      "workflow_id": "recovery",
      "description": "不猜测未提交编码结果与用户可恢复执行之间的约束",
      "observable_failure": "重启后旧任务永久 running 或被重复提交"
    },
    {
      "workflow_id": "resources",
      "description": "回收空间与历史渲染可用性之间的约束",
      "observable_failure": "尚有冻结引用的源字节被清除"
    },
    {
      "workflow_id": "matrix",
      "description": "整体提交与各自编码结果独立之间的约束",
      "observable_failure": "无效矩阵残留一部分已排队作业"
    },
    {
      "workflow_id": "conformance",
      "description": "容器声明与真实帧序列之间的约束",
      "observable_failure": "只信元数据导致不可解码成片被接受"
    },
    {
      "workflow_id": "lineage",
      "description": "同一来源重复剪辑与唯一内容节点之间的约束",
      "observable_failure": "图节点重复或缺少印本引用"
    }
  ],
