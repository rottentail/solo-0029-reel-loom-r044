  "entities": [
    {
      "id": "asset",
      "label": "媒体来源",
      "relations": [
        "asset.blob",
        "slice.asset"
      ],
      "invariants": [
        "ready 才能新引用，retired 不撤销旧冻结引用"
      ]
    },
    {
      "id": "blob",
      "label": "不可变媒体内容",
      "relations": [
        "asset.blob",
        "artifact.blob",
        "imprint.blob"
      ],
      "invariants": [
        "摘要即内容地址，提交前持久化字节"
      ]
    },
    {
      "id": "reel",
      "label": "剪辑卷",
      "relations": [
        "reel.revisions"
      ],
      "invariants": [
        "头修订递增，sealed 禁止改稿"
      ]
    },
    {
      "id": "revision",
      "label": "剪辑修订",
      "relations": [
        "revision.slices"
      ],
      "invariants": [
        "文档与 hash 写入后不可变"
      ]
    },
    {
      "id": "slice",
      "label": "镜段",
      "relations": [
        "slice.asset",
        "revision.slices"
      ],
      "invariants": [
        "入出点位于源时长，卷时间连续"
      ]
    },
    {
      "id": "look",
      "label": "输出版式",
      "relations": [
        "ticket.look_version"
      ],
      "invariants": [
        "已有版式版本不可改写"
      ]
    },
    {
      "id": "cue_track",
      "label": "字幕源轨",
      "relations": [
        "cue_track.asset"
      ],
      "invariants": [
        "源时间合法且已导入轨不可变"
      ]
    },
    {
      "id": "ticket",
      "label": "渲染单",
      "relations": [
        "ticket.snapshot",
        "ticket.artifacts"
      ],
      "invariants": [
        "冻结源闭包，完成与取消互斥"
      ]
    },
    {
      "id": "artifact",
      "label": "派生产物",
      "relations": [
        "artifact.blob",
        "artifact.ticket"
      ],
      "invariants": [
        "产物提交与任务成功在同一事务"
      ]
    },
    {
      "id": "analysis",
      "label": "音频测量",
      "relations": [
        "analysis.asset"
      ],
      "invariants": [
        "内容与参数相同才复用"
      ]
    },
    {
      "id": "imprint",
      "label": "交付印本",
      "relations": [
        "imprint.ticket",
        "imprint.blob"
      ],
      "invariants": [
        "交付清单与媒体字节均可校验"
      ]
    },
    {
      "id": "matrix",
      "label": "渲染矩阵",
      "relations": [
        "matrix.tickets"
      ],
      "invariants": [
        "入队全有全无，运行结果独立聚合"
      ]
    }
  ],
  "state_machines": [
    {
      "subject": "asset",
      "states": [
        "ready",
        "retired"
      ],
      "transitions": [
        "ready->retired",
        "retired->ready"
      ],
      "invariants": [
        "恢复须验证字节可用"
      ]
    },
    {
      "subject": "reel",
      "states": [
        "open",
        "sealed"
      ],
      "transitions": [
        "open->sealed"
      ],
      "invariants": [
        "sealed 不可再写修订"
      ]
    },
    {
      "subject": "ticket",
      "states": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "transitions": [
        "queued->running",
        "queued->cancelled",
        "running->succeeded",
        "running->failed",
        "running->cancelled",
        "failed->queued",
        "cancelled->queued"
      ],
      "invariants": [
        "成功不允许重试；重试仍使用原快照"
      ]
    },
    {
      "subject": "matrix",
      "states": [
        "queued",
        "running",
        "succeeded",
        "finished_with_failures"
      ],
      "transitions": [
        "queued->running",
        "running->succeeded",
        "running->finished_with_failures",
        "finished_with_failures->running"
      ],
      "invariants": [
        "整体状态由成员真实状态聚合"
      ]
    },
    {
      "subject": "blob",
      "states": [
        "temporary",
        "durable_unregistered",
        "registered",
        "unreferenced",
        "collected"
      ],
      "transitions": [
        "temporary->durable_unregistered",
        "durable_unregistered->registered",
        "registered->unreferenced",
        "unreferenced->collected"
      ],
      "invariants": [
        "字节先 fsync 和原子替换再登记；未登记孤儿只报告"
      ]
    },
    {
      "subject": "imprint",
      "states": [
        "building",
        "frozen",
        "verified"
      ],
      "transitions": [
        "building->frozen",
        "frozen->verified"
      ],
      "invariants": [
        "校验不改写冻结内容；building 只存在于 scratch"
      ]
    }
  ],
