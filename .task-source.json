  "extension_seams": [
    {
      "id": "streaming",
      "anchor": "reel_loom/planner.py::compile + reel_loom/imprints.py::create",
      "entry": "POST /tickets/{id}/imprints",
      "distinct_outcome": "可播放的分段媒体与稳定的清单",
      "mechanism": "export_freeze"
    },
    {
      "id": "dubbing",
      "anchor": "reel_loom/reels.py::normalize + reel_loom/planner.py::freeze",
      "entry": "POST /tickets",
      "distinct_outcome": "按配音版本生成同画异声成片",
      "mechanism": "snapshot_consistency"
    },
    {
      "id": "dissolve",
      "anchor": "reel_loom/reels.py::normalize + reel_loom/planner.py::compile",
      "entry": "POST /tickets",
      "distinct_outcome": "转场后的成片与正确字幕时域",
      "mechanism": "time_semantics"
    },
    {
      "id": "retiming",
      "anchor": "reel_loom/reels.py::normalize + reel_loom/timebase.py::project_interval",
      "entry": "POST/PUT /reels",
      "distinct_outcome": "变速成片的字幕和声音正确对齐",
      "mechanism": "policy_rules"
    },
    {
      "id": "redaction",
      "anchor": "reel_loom/planner.py::freeze + reel_loom/imprints.py::create",
      "entry": "POST /tickets",
      "distinct_outcome": "遮挡处理后的成片及可核验覆盖信息",
      "mechanism": "authorization"
    },
    {
      "id": "reframe",
      "anchor": "reel_loom/looks.py::normalize + reel_loom/planner.py::compile",
      "entry": "POST /tickets",
      "distinct_outcome": "可复演的动态竖屏构图",
      "mechanism": "resource_lifecycle"
    },
    {
      "id": "stems",
      "anchor": "reel_loom/looks.py::normalize + reel_loom/artifacts.py::commit_render",
      "entry": "POST /tickets/{id}/imprints",
      "distinct_outcome": "母版与独立分轨组成完整交付",
      "mechanism": "lineage"
    },
    {
      "id": "ducking",
      "anchor": "reel_loom/reels.py::normalize + reel_loom/planner.py::compile",
      "entry": "POST /tickets",
      "distinct_outcome": "有旁白时压低背景且整卷可复听",
      "mechanism": "concurrency"
    },
    {
      "id": "interpolation",
      "anchor": "reel_loom/looks.py::normalize + reel_loom/conformance.py::inspect",
      "entry": "GET /artifacts/{id}/conformance",
      "distinct_outcome": "高帧率平滑成片及验规结果",
      "mechanism": "capacity"
    },
    {
      "id": "deinterlace",
      "anchor": "reel_loom/probe.py::inspect_media + reel_loom/planner.py::compile",
      "entry": "POST /tickets",
      "distinct_outcome": "按来源正确还原运动且输出逐行成片",
      "mechanism": "state_machine"
    },
    {
      "id": "burnin",
      "anchor": "reel_loom/captions.py::project + reel_loom/planner.py::freeze",
      "entry": "POST /assets/{id}/cues + POST /reels/{id}/captions",
      "distinct_outcome": "实际画面内含字幕且可追溯",
      "mechanism": "versioning_audit"
    },
    {
      "id": "scenes",
      "anchor": "reel_loom/analysis.py::run + reel_loom/reels.py::normalize",
      "entry": "POST/PUT /reels",
      "distinct_outcome": "可审阅并应用的镜段提案",
      "mechanism": "ranking_reorder"
    },
    {
      "id": "comparison",
      "anchor": "reel_loom/batches.py::submit + reel_loom/planner.py::compile",
      "entry": "POST /matrices",
      "distinct_outcome": "同步并排可复听的版式比较产物",
      "mechanism": "concurrency"
    },
    {
      "id": "leases",
      "anchor": "reel_loom/tickets.py::claim + reel_loom/instance.py::acquire",
      "entry": "服务启动及 POST /tickets/{id}/retry",
      "distinct_outcome": "多进程可接力但不重复提交",
      "mechanism": "ranking_reorder"
    },
    {
      "id": "delta",
      "anchor": "reel_loom/imprints.py::create + reel_loom/resources.py::sweep",
      "entry": "POST /tickets/{id}/imprints",
      "distinct_outcome": "可验证重建的差量媒体交付",
      "mechanism": "delete_removal"
    }
  ],
  "tension_points": [
    {
      "workflow_id": "ingest",
      "description": "允许内容复用但禁止把退役来源重新隐式启用",
      "observable_failure": "旧来源被替换或无效媒体可被编排"
